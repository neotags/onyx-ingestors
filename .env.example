# Copy to .env and fill in real values. .env is git-ignored.

# --- Confluence ---
CONFLUENCE_BASE_URL=https://example.atlassian.net/wiki

# Authentication (auto = cloud id -> scoped, username -> basic, token-only -> bearer):
#   basic  : Confluence Cloud classic API token (email + token) or Data Center
#   bearer : Confluence Data Center Personal Access Token
#   scoped : Atlassian scoped API token (requires CONFLUENCE_CLOUD_ID)
CONFLUENCE_AUTH_TYPE=auto
CONFLUENCE_CLOUD_ID=
CONFLUENCE_USERNAME=
CONFLUENCE_TOKEN=

CONFLUENCE_CQL="type=page AND space=ENG"

# --- Onyx ---
ONYX_BASE_URL=https://onyx.example.com
ONYX_API_KEY=
ONYX_CC_PAIR_ID=
# Endpoint override when the deployment mounts the API on a custom path
# (e.g. the Onyx chart nginx, which only forwards /api/*). Leave empty
# otherwise; the official default is /onyx-api/ingestion.
ONYX_INGESTION_PATH=

HTTP_TIMEOUT=30s
# Ingestion is server-side pipeline work; on a busy Onyx it can exceed 30s
# per document. Default 2m; if you set HTTP_TIMEOUT explicitly and leave
# this unset, ingestion inherits HTTP_TIMEOUT instead.
ONYX_HTTP_TIMEOUT=120s
